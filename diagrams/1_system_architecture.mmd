        DockerPy["python:3.11-alpine Sandbox"]
        DockerJava["maven:3.9-eclipse-temurin-17 Sandbox"]

        Sandbox --> DockerNode
        Sandbox --> DockerPy
        Sandbox --> DockerJava
    end

    subgraph ExternalServices["External LLM Cloud"]
        GeminiFlash["Google Gemini 3.1 Flash Lite"]
    end

    UI --> Express
    BullMQQueue --> AgentPipeline
    Critic --> KeyRotator
    Coder --> KeyRotator
    KeyRotator --> GeminiFlash
    Express --> Mongo
    Express --> Redis
